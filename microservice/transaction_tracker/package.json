{
  "name": "amadeus-transaction-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "Amadeus Transaction State Tracker — papan skor status transaksi lintas robot RPA untuk proses settlement Import LC/SKBDN/SBLC.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate --config-file pgmigrate.config.cjs up",
    "migrate:create": "node-pg-migrate --config-file pgmigrate.config.cjs create",
    "robot:register": "tsx scripts/registerRobot.ts"
  },
  "dependencies": {
    "@fastify/sensible": "^5.6.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^7.5.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
